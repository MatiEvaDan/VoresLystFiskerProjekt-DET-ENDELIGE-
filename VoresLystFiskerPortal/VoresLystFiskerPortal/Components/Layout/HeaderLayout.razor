@inject NavigationManager NavManager
@inject SignInManager<ApplicationUser> SignInManager
@rendermode InteractiveServer

@* Nøgleændringen: Vi bruger AuthorizeView til at få adgang til brugerdata *@
<AuthorizeView>
    <Authorized Context="Auth">
        <div class="Header-Component">
            <header class="app-header">
                <div class="profilcontainer">
                    @* Viser brugernavn direkte fra Context *@
                    <button class="home-btn" @onclick="NavigateToProfile">@Auth.User.Identity?.Name </button>

                    @* Opdateret @onclick: Kalder nu metoden med UserId fra Context *@
                    <button class="home-btn" @onclick="NavigateToProfile">
                        <img src="/Images/ProfilImageLystFisker.jpg"
                             alt="User profilImage"
                             style="border-radius: 50%; width: 40px; height: 40px; object-fit: cover; border: 2px solid #fff;" />
                    </button>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Log ud
                        </button>
                    </form>

                    <button class="home-btn" @onclick="NavigateToHome">
                        <img src="/Images/HomeBntLystFisker.jpg"
                             alt="Home ikon"
                             style="border-radius: 50%; width: 40px; height: 40px; object-fit: cover; border: 2px solid #fff;" />
                    </button>
                    
                    <button class="home-btn" @onclick="NavigateToLeaderBoardPage">
                        <img src="/Images/Leaderboard_Ikon.jpg"
                             alt="Leaderboard ikon"
                             style="border-radius: 50%; width: 40px; height: 40px; object-fit: cover; border: 2px solid #fff;" />
                    </button>
                    
                    <div class="search-section">
                        <input type="text" placeholder="Søg i systemet" class="search-input" />
                    </div>
                </div>
            </header>
        </div>
    </Authorized>
    <NotAuthorized>
        @* Håndter usloggede brugere, f.eks. vis login-knap her *@
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? currentUrl;
    private void NavigateToHome()
    {
        NavManager.NavigateTo("/feed");
    }

    private void NavigateToLeaderBoardPage()
    {
        NavManager.NavigateTo("/leaderboardpage");
    }

    // BEHOLDER ARGUMENTET
    private void NavigateToUserProfil(string userId)
    {
        NavManager.NavigateTo($"/UserFeed/{userId}");
    }
    private void NavigateToProfile()
    {
        NavManager.NavigateTo("/Profile");
    }
   
}


