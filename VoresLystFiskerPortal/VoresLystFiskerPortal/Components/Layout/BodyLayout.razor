<div class="global-background">
    <div class="content-container">
        @ChildContent
    </div>
</div>

<style>
    html, body {
        height: 100%;
    }

    .global-background {
        background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/images/fishing_background.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: scroll
        padding-top: 0 !important;

        min-height: 100vh;
        width: 100vw;
        position: relative;
        z-index: 1;

    }

    .content-container {
        position: relative;
        z-index: 10;
    }



</style>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }
}