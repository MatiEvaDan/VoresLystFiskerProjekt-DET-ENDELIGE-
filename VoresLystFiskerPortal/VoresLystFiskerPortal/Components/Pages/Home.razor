@page "/"
@inject NavigationManager Nav
@rendermode InteractiveServer

<link rel="stylesheet" href="css/Homecss.css" />

<div class="hero">
    <div class="hero-content">
        <h1>Lystfiskerportalen</h1>

        <p class="lead">
            Del dine fangster, teknikker og oplevelser – og bliv inspireret af andre lystfiskere.
        </p>

        <div class="cta-buttons">
            <button class="btn btn-primary btn-lg" @onclick="GoToRegister">Opret bruger</button>
            <button class="btn btn-outline-light btn-lg" @onclick="GoToLogin">Log ind</button>
        </div>
    </div>
</div>

@code {
    private void GoToRegister()
    {
        Nav.NavigateTo("/Account/Register"); // Identity route i .NET 8
    
    }

    private void GoToLogin()
    {
        Nav.NavigateTo("/Account/Login"); // Identity route i .NET 8
    }
}

