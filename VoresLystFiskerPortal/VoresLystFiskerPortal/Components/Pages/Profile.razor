@page "/profile"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthenticationState 

<EditProfileComponent></EditProfileComponent>



<button class="home-btn" @onclick="ShowCreatePostForm">
    <img src="/Images/CreatePost_Ikon.png"
         alt="CreatePost_Ikon"
         style="border-radius: 50%; width: 40px; height: 40px; object-fit: cover; border: 2px solid #fff;" />Nyt Opslag
</button>
@if (showCreatePost)
{
    <PostFormComponent OnPostCreated="OnPostCreatedHandler" />
}

<Feed UserId="@loggedInUserId" />




@code {
    private string loggedInUserId;
    private bool showCreatePost;

    private void ShowCreatePostForm()
    {
        showCreatePost = true;
    }
    private void OnPostCreatedHandler(Post newPost)
    {
        showCreatePost = false;
        NavManager.NavigateTo("/profile");
    }


    protected override async Task OnInitializedAsync()
    {
        // Hent brugerens ID fra AuthenticationState
        var authState = await AuthenticationState.GetAuthenticationStateAsync();
        var user = authState.User;
        loggedInUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    }

}

