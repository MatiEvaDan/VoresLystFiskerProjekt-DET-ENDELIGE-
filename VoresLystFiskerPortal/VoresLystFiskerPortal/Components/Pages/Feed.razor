@page "/feed"
@page "/userfeed/{UserId}" 
@inject IPostRepo PostRepo
@attribute [Authorize]

<BodyLayout>
    <div class="container" style="max-width: 700px; margin-top: 20px;">

        @if (posts == null)
        {
            <div class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Indlæser...</span>
                </div>
                <p>Henter fangster...</p>
            </div>
        }
        else if (!posts.Any())
        {
            <div class="alert alert-info text-center">
                Der er ingen posts fra denne bruger endnu.
            </div>
        }
        else
        {
            @foreach (var post in posts)
            {
                <PostCardComponent PostData="post" />
            }
        }
    </div>
</BodyLayout>

   



@code {
    private List<Post> posts;

    [Parameter]
    public string UserId { get; set; } 

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(UserId))
        {
            posts = await PostRepo.GetUserPostsAsync(UserId);
        }
        else
        {
            posts = await PostRepo.GetFeedPostsAsync();
        }
    }

   z
}